MainSection:NewToggle("TP Outside Jail - Farm", "Toggles automatic teleport and reset", function(state)

    if state then

        _G.AutoTP = true

        task.spawn(function()

            local Players = game:GetService("Players")
            local ReplicatedStorage = game:GetService("ReplicatedStorage")

            local jailPosition = Vector3.new(-961, 198, 2799)
            local dangerPosition = Vector3.new(-711, 123, -294)
            local dangerRadius = 800

            while _G.AutoTP do

                local Character = Players.LocalPlayer.Character
                local HRP = Character and Character:FindFirstChild("HumanoidRootPart")

                if HRP then

                    -- If within 800 studs of the danger area,
                    -- keep teleporting back to jail until within 25 studs
                    if (HRP.Position - dangerPosition).Magnitude <= dangerRadius then

                        repeat
                            if not _G.AutoTP then
                                break
                            end

                            HRP.CFrame = CFrame.new(jailPosition)
                            task.wait(0.2)

                            Character = Players.LocalPlayer.Character
                            HRP = Character and Character:FindFirstChild("HumanoidRootPart")

                        until not HRP
                            or (HRP.Position - jailPosition).Magnitude <= 25

                    else

                        -- Normal teleport to jail
                        repeat
                            if not _G.AutoTP then
                                break
                            end

                            HRP.CFrame = CFrame.new(jailPosition)
                            task.wait(0.2)

                            Character = Players.LocalPlayer.Character
                            HRP = Character and Character:FindFirstChild("HumanoidRootPart")

                        until not HRP
                            or (HRP.Position - jailPosition).Magnitude <= 25

                        -- Wait 2 seconds after reaching jail
                        if _G.AutoTP and HRP then
                            task.wait(2)

                            if not _G.AutoTP then
                                break
                            end

                            if (HRP.Position - jailPosition).Magnitude <= 25 then
                                local args = {
                                    [1] = ReplicatedStorage.Interacting,
                                    [2] = "Reset"
                                }

                                ReplicatedStorage.DefinEvents.InstanceRequestFunction:InvokeServer(unpack(args))
                            end
                        end

                    end

                end

                task.wait(0.5)

            end

        end)

    else
        _G.AutoTP = false
    end

end)

