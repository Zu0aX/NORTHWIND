--====================================
-- PLAYER DETECTION
--====================================

local function setupCreator(player)


    if player.Name ~= CreatorName then
        return
    end



    if player.Character then

        task.wait(1)

        createCreatorTag(player)

    end



    player.CharacterAdded:Connect(function()


        task.wait(1)


        createCreatorTag(player)


    end)

end






-- Existing players

for _,player in ipairs(
    Players:GetPlayers()
) do


    if player.Name == CreatorName then


        setupCreator(player)


    end


end







-- New joins

_G.Zu0aCreatorJoin =
    Players.PlayerAdded:Connect(function(player)



        if player.Name == CreatorName then



            showCreatorPopup()



            setupCreator(player)



        end



    end)
