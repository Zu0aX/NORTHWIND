--====================================
-- ZU0AX CREATOR BADGE
-- NORTHWIND STYLE
--====================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local CreatorName = "Zu0a"



-- Remove old version if re-executed

if CoreGui:FindFirstChild("Zu0aCreatorUI") then
    CoreGui.Zu0aCreatorUI:Destroy()
end






local LocalPlayer = Players.LocalPlayer


local function createCreatorTag(player)

    if player.Name ~= CreatorName then
        return
    end


    if player == LocalPlayer then
        return
    end



    local character =
        player.Character


    if not character then
        return
    end



    local head =
        character:FindFirstChild("Head")


    if not head then
        return
    end



    if head:FindFirstChild(
        "Zu0aCreatorTag"
    ) then

        head.Zu0aCreatorTag:Destroy()

    end






    local billboard =
        Instance.new("BillboardGui")


    billboard.Name =
        "Zu0aCreatorTag"


    billboard.Parent =
        head


    billboard.Adornee =
        head


billboard.Size =
    UDim2.fromOffset(
        140,
        25
    )


billboard.StudsOffset =
    Vector3.new(
        0,
        3.5,
        0
    )


    billboard.AlwaysOnTop =
        true







    local label =
        Instance.new("TextLabel")


    label.Parent =
        billboard


    label.Size =
        UDim2.fromScale(
            1,
            1
        )


    label.BackgroundTransparency =
        1



    label.Text =
        "Zu0aX Creator"



    label.Font =
        Enum.Font.Code



label.TextSize =
    18



    label.TextStrokeTransparency =
        0



    label.TextStrokeColor3 =
        Color3.fromRGB(
            0,
            0,
            0
        )



    label.TextColor3 =
        Color3.fromRGB(
            0,
            255,
            120
        )








    -- gradient

    local gradient =
        Instance.new("UIGradient")


    gradient.Color =
        ColorSequence.new({

            ColorSequenceKeypoint.new(
                0,
                Color3.fromRGB(
                    0,
                    255,
                    100
                )
            ),


            ColorSequenceKeypoint.new(
                .5,
                Color3.fromRGB(
                    0,
                    220,
                    255
                )
            ),


            ColorSequenceKeypoint.new(
                1,
                Color3.fromRGB(
                    60,
                    100,
                    255
                )
            )

        })


    gradient.Parent =
        label






    -- moving gradient

    task.spawn(function()


        while label.Parent do


            gradient.Offset =
                Vector2.new(
                    -1,
                    0
                )


            TweenService:Create(
                gradient,
                TweenInfo.new(
                    2,
                    Enum.EasingStyle.Linear
                ),
                {
                    Offset =
                        Vector2.new(
                            1,
                            0
                        )
                }
            ):Play()



            task.wait(
                2
            )


        end


    end)






    -- glow pulse

    local stroke =
        Instance.new("UIStroke")


    stroke.Parent =
        label


    stroke.Thickness =
        1.5


    stroke.Color =
        Color3.fromRGB(
            0,
            255,
            150
        )



    task.spawn(function()


        while label.Parent do


            local pulse =
                (math.sin(
                    tick()*4
                )+1)/2



            stroke.Transparency =
                .2 +
                pulse*.5



            task.wait()

        end


    end)


end
