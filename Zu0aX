--==================================================
-- CHECK WELD
--==================================================

local function checkWeld(weld)

    if not weld
        or not weld:IsA("Weld") then

        return
    end

    local oldData =
        WeldData[weld]

    local part0 =
        weld.Part0

    local part1 =
        weld.Part1

    --==================================================
    -- INVALID
    --==================================================

    if not part0 or not part1 then

        if oldData then
            clearCharacter(
                oldData.Character
            )
        end

        WeldData[weld] = nil

        return
    end

    --==================================================
    -- ONLY HANDS
    --==================================================

    if part1.Name ~= "RightHand"
        and part1.Name ~= "LeftHand" then

        -- Unequipped
        if oldData then
            clearCharacter(
                oldData.Character
            )
        end

        WeldData[weld] = nil

        return
    end

    --==================================================
    -- CHARACTER
    --==================================================

    local character =
        part1.Parent

    if not character
        or not character:IsA("Model") then

        return
    end

    --==================================================
    -- NEVER TRACK LOCAL PLAYER
    --==================================================

    if isLocalCharacter(character) then

        clearCharacter(character)

        WeldData[weld] = nil

        return
    end

    --==================================================
    -- FIND WOOD / HANDLE
    --==================================================

    local weaponPart, meshId =
        findWeaponPart(part0)

    if not weaponPart then
        return
    end

    --==================================================
    -- WEAPON NAME
    --==================================================

    local weaponName =
        WeaponMeshes[meshId]

    if not weaponName then
        return
    end

    --==================================================
    -- CHARACTER CHANGED
    --==================================================

    if oldData
        and oldData.Character
        and oldData.Character ~= character then

        clearCharacter(
            oldData.Character
        )

    end

    --==================================================
    -- SAVE
    --==================================================

    CharacterWeapons[character] =
        weaponName

    WeldData[weld] = {

        Character = character,
        WeaponName = weaponName,
        WeaponPart = weaponPart

    }

    --==================================================
    -- CREATE ESP
    --==================================================

    if HoldingESP then

        createESP(
            character,
            weaponPart,
            weaponName
        )

    end

end

--==================================================
-- TRACK WELD
--==================================================

local function trackWeld(weld)

    if not weld:IsA("Weld") then
        return
    end

    if WeldConnections[weld] then
        return
    end

    WeldConnections[weld] = true

    -- Initial check
    checkWeld(weld)

    -- Hand changes
    weld:GetPropertyChangedSignal(
        "Part1"
    ):Connect(function()

        checkWeld(weld)

    end)

    -- Weapon changes
    weld:GetPropertyChangedSignal(
        "Part0"
    ):Connect(function()

        checkWeld(weld)

    end)

end

--==================================================
-- INITIAL SCAN
--==================================================

for _, object in ipairs(
    EquipmentItems:GetDescendants()
) do

    if object:IsA("Weld") then
        trackWeld(object)
    end

end

--==================================================
-- NEW WELDS
--==================================================

EquipmentItems.DescendantAdded:Connect(
    function(object)

        if object:IsA("Weld") then

            task.defer(function()

                if object.Parent then
                    trackWeld(object)
                end

            end)

        end

    end
)

--==================================================
-- REMOVED WELDS
--==================================================

EquipmentItems.DescendantRemoving:Connect(
    function(object)

        if not object:IsA("Weld") then
            return
        end

        local data =
            WeldData[object]

        if data then

            clearCharacter(
                data.Character
            )

        end

        WeldData[object] = nil
        WeldConnections[object] = nil

    end
)

--==================================================
-- LOCAL PLAYER RESPAWN PROTECTION
--==================================================

LocalPlayer.CharacterAdded:Connect(
    function(character)

        task.wait(0.1)

        clearCharacter(character)

    end
)

