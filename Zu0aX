local EnergyRings = {}



local function CreateRing(
    width,
    height,
    speed,
    direction,
    thickness
)


    local ring =
        Instance.new("Frame")


    ring.Parent =
        Background


    ring.AnchorPoint =
        Vector2.new(
            .5,
            .5
        )


    ring.Position =
        UDim2.fromScale(
            .5,
            .47
        )


    ring.Size =
        UDim2.fromOffset(
            width,
            height
        )


    ring.BackgroundTransparency =
        1



    local corner =
        Instance.new("UICorner")


    corner.CornerRadius =
        UDim.new(
            1,
            0
        )


    corner.Parent =
        ring



    local stroke =
        Instance.new("UIStroke")


    stroke.Parent =
        ring


    stroke.Thickness =
        thickness


    stroke.Transparency =
        .2


    stroke.Color =
        Color3.fromRGB(
            255,
            80,
            0
        )



    table.insert(
        EnergyRings,
        {
            Frame = ring,
            Stroke = stroke,
            Speed = speed,
            Direction = direction
        }
    )


end



