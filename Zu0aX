        --====================================
        -- HEALTH EVENT
        --====================================

        local HealthEvent =
            ReplicatedStorage
            .DefinEvents
            .InstancePropertyFunction



        _G.HealthConnection =
            HealthEvent.OnClientEvent:Connect(function(player, property, value)


                if property == "Health"
                    and typeof(value) == "number"
                    and player:IsA("Player") then


                    HealthData[player] = value


                end


            end)






        local function getHealth(character)


            for player, health in pairs(HealthData) do


                if player.Character == character then

                    return health

                end


            end


            return nil


        end






        local function getHealthColor(percent)


            percent =
                math.clamp(
                    percent,
                    0,
                    100
                )


            if percent >= 50 then


                local t =
                    (100 - percent) / 50


                return Color3.fromRGB(
                    255 * t,
                    255,
                    0
                )


            else


                local t =
                    percent / 50


                return Color3.fromRGB(
                    255,
                    255 * t,
                    0
                )


            end


        end






        local function getText(character, folderName)


            local identification =
                character:FindFirstChild(
                    "Identification",
                    true
                )


            if not identification then
                return nil
            end



            local folder =
                identification:FindFirstChild(
                    folderName
                )


            if not folder then
                return nil
            end



            local text =
                folder:FindFirstChild(
                    "TextGui",
                    true
                )


            if text and text:IsA("TextLabel") then


                if text.Text ~= ""
                    and text.Text ~= "Label" then


                    return text.Text


                end


            end


            return nil

        end






        local function createESP(character)


            if not character:IsA("Model") then
                return
            end



            local root =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )


            if not root then
                return
            end



            if root:FindFirstChild(
                "CharacterESP"
            ) then
                return
            end






            -- CHAMS

            local highlight =
                Instance.new("Highlight")


            highlight.Name =
                "CharacterESP"


            highlight.Parent =
                character


            highlight.FillTransparency =
                0.65


            highlight.FillColor =
                Color3.fromRGB(
                    0,
                    255,
                    0
                )


            highlight.OutlineColor =
                Color3.fromRGB(
                    255,
                    255,
                    255
                )








            local billboard =
                Instance.new("BillboardGui")


            billboard.Name =
                "CharacterESP"


            billboard.Parent =
                root


            billboard.Adornee =
                root


            billboard.AlwaysOnTop =
                true


            billboard.Size =
                UDim2.fromOffset(
                    200,
                    100
                )


            billboard.StudsOffset =
                Vector3.new(
                    0,
                    5,
                    0
                )






            local function makeLabel(labelName)


                local label =
                    Instance.new("TextLabel")


                label.Name =
                    labelName


                label.Parent =
                    billboard


                label.Size =
                    UDim2.fromOffset(
