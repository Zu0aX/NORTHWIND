--==================================================

local showItems
local showItemDetails

local function showPlayers()

    currentPage = "players"
    selectedPlayer = nil
    selectedItem = nil

    clearContent()

    back.Visible = false
    copySelected.Visible = false
    copyAll.Visible = true

    title.Text = "Inventory Inspector — Players"

    local filter = string.lower(search.Text)
    local found = 0

    for playerName, inventory in pairs(
        getgenv().PlayerInventories
    ) do

        if filter == ""
            or string.find(
                string.lower(playerName),
                filter,
                1,
                true
            ) then

            local count = 0

            for _ in pairs(inventory) do
                count += 1
            end

            local button = makeButton(
                tostring(playerName) ..
                "    [" ..
                tostring(count) ..
                " items]",
                48
            )

            button.MouseButton1Click:Connect(function()
                selectedPlayer = playerName
                showItems(playerName)
            end)

            found += 1
        end
    end

    if found == 0 then

        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 50)
        empty.BackgroundTransparency = 1
        empty.Text = "No inventory data received yet."
        empty.TextColor3 = Color3.fromRGB(160, 160, 160)
        empty.TextSize = 14
        empty.Font = Enum.Font.Gotham
        empty.ZIndex = 3
        empty.Parent = content
    end

    updateCanvas()
end

