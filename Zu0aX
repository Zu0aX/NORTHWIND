-- ITEM PAGE
--==================================================

showItems = function(playerName)

    currentPage = "items"
    selectedPlayer = playerName
    selectedItem = nil

    clearContent()

    back.Visible = true
    copySelected.Visible = false
    copyAll.Visible = true

    title.Text =
        "Inventory — " ..
        tostring(playerName)

    local inventory =
        getgenv().PlayerInventories[playerName]

    if not inventory then
        return
    end

    local filter = string.lower(search.Text)

    for itemId, data in pairs(inventory) do

        local itemName = ""

        if type(data) == "table" then
            itemName =
                tostring(
                    data.CustomName
                    or data.Name
                    or ""
                )
        end

        local searchable =
            string.lower(
                tostring(itemId) ..
                " " ..
                itemName
            )

        if filter == ""
            or string.find(
                searchable,
                filter,
                1,
                true
            ) then

            local button = makeButton(
                (
                    itemName ~= ""
                    and itemName
                    or tostring(itemId)
                ) ..
                "\n" ..
                tostring(itemId),
                65
            )

            button.TextSize = 13

            button.MouseButton1Click:Connect(function()
                selectedItem = itemId

                showItemDetails(
                    playerName,
                    itemId,
                    data
                )
            end)
        end
    end

    updateCanvas()
end

