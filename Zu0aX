--==================================================
-- LOCAL PLAYER CHECK
--==================================================

local function isLocalCharacter(character)

    if not character then
        return false
    end

    if LocalPlayer.Character
        and character == LocalPlayer.Character then

        return true
    end

    if character.Name == LocalPlayer.Name then
        return true
    end

    return false

end

--==================================================
-- GET MESH ID
--==================================================

local function getMeshId(object)

    if not object then
        return nil
    end

    if not ValidWeaponParts[object.Name] then
        return nil
    end

    -- MeshPart
    if object:IsA("MeshPart") then

        return tostring(
            object.MeshId
        ):match("%d+")

    end

    -- SpecialMesh
    if object:IsA("SpecialMesh") then

        return tostring(
            object.MeshId
        ):match("%d+")

    end

    -- A Part containing SpecialMesh
    local specialMesh =
        object:FindFirstChildOfClass(
            "SpecialMesh"
        )

    if specialMesh then

        return tostring(
            specialMesh.MeshId
        ):match("%d+")

    end

    return nil

end

--==================================================
-- FIND WOOD / HANDLE
--==================================================

local function findWeaponPart(part0)

    if not part0 then
        return nil
    end

    -- Part0 itself
    local meshId =
        getMeshId(part0)

    if meshId then
        return part0, meshId
    end

    -- Descendants
    for _, object in ipairs(
        part0:GetDescendants()
    ) do

        meshId =
            getMeshId(object)

        if meshId then
            return object, meshId
        end

    end

    return nil

end

--==================================================
-- REMOVE ESP
--==================================================

local function removeESP(character)

    local esp =
        ESPObjects[character]

    if not esp then
        return
    end

    if esp.Billboard then
        esp.Billboard:Destroy()
    end

    ESPObjects[character] = nil

end

--==================================================
-- CLEAR CHARACTER
--==================================================

local function clearCharacter(character)

    if not character then
        return
    end

    CharacterWeapons[character] = nil

    removeESP(character)

end

--==================================================
-- CREATE WEAPON ESP
--==================================================

local function createESP(
    character,
    weaponPart,
    weaponName
)

    -- NEVER SHOW LOCAL PLAYER
    if isLocalCharacter(character) then
        return
    end

    if not weaponPart then
        return
    end

    -- Remove old ESP
    removeESP(character)

    --==================================================
    -- BILLBOARD ATTACHED TO ACTUAL WEAPON
    --==================================================

    local billboard =
        Instance.new("BillboardGui")

    billboard.Name =
        "CurrentlyHoldingESP"

    billboard.Adornee =
        weaponPart

    billboard.Parent =
        weaponPart

    billboard.AlwaysOnTop =
        true

