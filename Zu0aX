local function StartHeadHitboxScanner()
    if getgenv().HeadHitboxScanner then
        return
    end

    getgenv().HeadHitboxScanner = true

    task.spawn(function()
        local Players = game:GetService("Players")

        while getgenv().HeadHitboxScanner do
            local currentSize = getgenv().HeadHitboxSize or 0.1

            -- Players
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= Players.LocalPlayer then
                    local character = player.Character
                    local head = character and character:FindFirstChild("Head")

                    if head then
                        head.Size = Vector3.new(
                            currentSize,
                            currentSize,
                            currentSize
                        )
                        head.Material = Enum.Material.Neon
                        head.BrickColor = BrickColor.new("Really red")
                        head.Transparency = 0.7
                    end
                end
            end

            -- Workspace.Characters
            local charactersFolder = workspace:FindFirstChild("Characters")

            if charactersFolder then
                for _, character in ipairs(charactersFolder:GetChildren()) do
                    local head = character:FindFirstChild("Head")

                    if head then
                        head.Size = Vector3.new(
                            currentSize,
                            currentSize,
                            currentSize
                        )
                        head.Material = Enum.Material.Neon
                        head.BrickColor = BrickColor.new("Really red")
                        head.Transparency = 0.7
                    end
                end
            end

            task.wait(1)
        end
    end)
end


