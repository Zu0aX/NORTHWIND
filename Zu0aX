--==================================================

local function serializeItem(playerName, itemId, data)

    local output = {}

    table.insert(output, "========================================")
    table.insert(output, "PLAYER: " .. tostring(playerName))
    table.insert(output, "ITEM ID: " .. tostring(itemId))
    table.insert(output, "========================================")

    if data == false then
        table.insert(output, "STATUS: REMOVED")
        return table.concat(output, "\n")
    end

    if type(data) ~= "table" then
        table.insert(output, "DATA: " .. tostring(data))
        return table.concat(output, "\n")
    end

    table.insert(output, "Name: " .. tostring(data.Name))
    table.insert(output, "CustomName: " .. tostring(data.CustomName))
    table.insert(output, "Durability: " .. tostring(data.Durability))
    table.insert(output, "Origin: " .. tostring(data.Origin))
    table.insert(output, "OriginalCrafter: " .. tostring(data.OriginalCrafter))

    if type(data.SegmentMaterials) == "table" then
        table.insert(output, "")
        table.insert(output, "SegmentMaterials:")

        for name, material in pairs(data.SegmentMaterials) do
            table.insert(
                output,
                "  " .. tostring(name) .. " = " .. tostring(material)
            )
        end
    end

    if type(data.CraftedItemIds) == "table" then
        table.insert(output, "")
        table.insert(output, "CraftedItemIds:")

        for index, craftedId in pairs(data.CraftedItemIds) do
            table.insert(
                output,
                "  [" .. tostring(index) .. "] = " ..
                tostring(craftedId)
            )
        end
    end

    if type(data.AmmunitionAbstractItems) == "table" then
        table.insert(output, "")
        table.insert(output, "AmmunitionAbstractItems:")

        for id, ammo in pairs(data.AmmunitionAbstractItems) do
            table.insert(
                output,
                "  " .. tostring(id) .. " = " ..
                tostring(ammo)
            )
        end
    end

    return table.concat(output, "\n")
end

