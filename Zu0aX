                label.TextStrokeColor3 =
                    Color3.fromRGB(
                        0,
                        0,
                        0
                    )


                label.Font =
                    Enum.Font.GothamBold


                label.TextSize =
                    12


                label.Visible =
                    false


                return label

            end






