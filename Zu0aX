--==================================================
-- INVENTORY REPLICATION
--==================================================

local event =
    ReplicatedStorage
    :WaitForChild("DefinEvents")
    :WaitForChild("InstanceReplicateFunction")

getgenv().InventoryConnection =
    event.OnClientEvent:Connect(function(...)

        if not getgenv().InventoryGUIRunning then
            return
        end

        local args = {...}

        local player = args[1]
        local action = args[2]

        if typeof(player) ~= "Instance"
            or not player:IsA("Player") then
            return
        end

        if action ~= "UpdateInventoryAbstractItem"
            and action ~= "UpdateInventoryAbstractItems" then
            return
        end

        local playerName = player.Name

        getgenv().PlayerInventories[playerName] =
            getgenv().PlayerInventories[playerName]
            or {}

        if action == "UpdateInventoryAbstractItem" then

            local itemId = args[3]
            local data = args[4]

            if itemId then

                if data == false then

                    getgenv().PlayerInventories[
                        playerName
                    ][itemId] = nil

                else

                    getgenv().PlayerInventories[
                        playerName
                    ][itemId] = data

                end
            end
        end

        if action == "UpdateInventoryAbstractItems" then

            local items = args[3]

            if type(items) == "table" then

                for itemId, data in pairs(items) do

                    if data == false then

                        getgenv().PlayerInventories[
                            playerName
                        ][itemId] = nil

                    else

                        getgenv().PlayerInventories[
                            playerName
                        ][itemId] = data

                    end
                end
            end
        end

        if currentPage == "players" then

            showPlayers()

        elseif currentPage == "items"
            and selectedPlayer == playerName then

            showItems(playerName)

        elseif currentPage == "details"
            and selectedPlayer == playerName
            and selectedItem then

            local inventory =
                getgenv().PlayerInventories[playerName]

            if inventory
                and inventory[selectedItem] then

                showItemDetails(
                    playerName,
                    selectedItem,
                    inventory[selectedItem]
                )

            else

                showItems(playerName)

            end
        end
    end)

