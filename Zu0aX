        MainSection:NewTextBox("Load House", "Enter house name", function(txt)

    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local localPlayer = Players.LocalPlayer

    local searchName = tostring(txt)
        :lower()
        :gsub("^%s*(.-)%s*$", "%1")

    if searchName == "" then
        warn("Enter a house name.")
        return
    end

    local scrollingContent =
        localPlayer.PlayerGui
        :WaitForChild("InterfaceGuis")
        :WaitForChild("Houses")
        :WaitForChild("Main")
        :WaitForChild("Items")
        :WaitForChild("ScrollingContent")

    local foundId = nil

    -- Check every house ID
    for _, house in ipairs(scrollingContent:GetChildren()) do

        -- House IDs are numeric
        if tonumber(house.Name) then

            local houseName = house:FindFirstChild("Content")
                and house.Content:FindFirstChild("HouseName")

            if houseName then

                local textGui =
                    houseName:FindFirstChild("TextGui")

                if textGui and textGui:IsA("TextLabel") then

                    local displayedName =
                        tostring(textGui.Text)
                        :lower()
                        :gsub("^%s*(.-)%s*$", "%1")

                    if displayedName == searchName then
                        foundId = house.Name
                        break
                    end
                end
            end
        end
    end

    if not foundId then
        warn("House not found: " .. txt)
        return
    end

    print("Found house:", txt)
    print("House ID:", foundId)

    local args = {
        [1] = ReplicatedStorage.Interacting,
        [2] = "LoadHouse",
        [3] = foundId,
    }

    ReplicatedStorage.DefinEvents.InstanceRequestFunction
        :InvokeServer(table.unpack(args))

    print("Loaded:", txt)
end)

